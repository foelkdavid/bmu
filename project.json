{
  "langrev": "1",
  "version": "0.1.0",
  "opt": "O1",
  "build-dir": "build",
  "output": "build",
  "dependency-search-paths": ["lib"],
  "targets": {
    "bmu-check": {
      "type": "executable",
      "sources": ["dev/tests/**"],
      "dependencies": ["raylib6", "bmu"]
    },
    "example-hello": {
      "type": "executable",
      "sources": ["examples/hello/**"],
      "dependencies": ["raylib6", "bmu"]
    },
    "example-gallery": {
      "type": "executable",
      "sources": ["examples/gallery/**"],
      "dependencies": ["raylib6", "bmu"]
    }
  }
}
