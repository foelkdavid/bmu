# raylib spins the CPU for the last 5% of every frame wait (SUPPORT_PARTIALBUSY_WAIT_LOOP): 5.7% of a core for an
# idle 60 FPS window. Sleep only (1.2%). Applied by build-raylib.sh.
--- a/src/config.h	2026-11-23 12:06:23.342768971 +0100
+++ b/src/config.h	2026-11-23 12:06:23.345768950 +0100
@@ -92,7 +92,7 @@
 #if !SUPPORT_PARTIALBUSY_WAIT_LOOP && !SUPPORT_BUSY_WAIT_LOOP
     // Use a partial-busy wait loop, in this case frame sleeps for most of the time,
     // but then runs a busy loop at the end for accuracy
-    #define SUPPORT_PARTIALBUSY_WAIT_LOOP   1
+    #define SUPPORT_PARTIALBUSY_WAIT_LOOP   0  // bmu patch: sleep only, no busy wait (idle CPU 5.7% -> 1.2% of a core)
 #endif
 #ifndef SUPPORT_SCREEN_CAPTURE
     // Allow automatic screen capture of current screen pressing F12, defined in KeyCallback()
