+// bmu patch: put `count` formats (MIME type + bytes) on the clipboard; they are copied. Returns 1 on success.
+int bmuSetClipboardData(int count, const char* const* mimes, const void* const* datas, const size_t* sizes)
+{
+    if (count <= 0 || count > BMU_CLIP_MAX || !_glfw.wl.dataDeviceManager || !_glfw.wl.dataDevice)
+        return 0;
+    if (_glfw.wl.selectionSource)
+    {
+        wl_data_source_destroy(_glfw.wl.selectionSource);
+        _glfw.wl.selectionSource = NULL;
+    }
+    bmuClipClear();
+    for (int i = 0; i < count; i++)
+    {
+        bmuClipMime[i] = _glfw_strdup(mimes[i]);
+        bmuClipData[i] = _glfw_calloc(1, sizes[i] ? sizes[i] : 1);
+        if (!bmuClipMime[i] || !bmuClipData[i])
+        {
+            bmuClipCount = i + 1;
+            bmuClipClear();
+            return 0;
+        }
+        memcpy(bmuClipData[i], datas[i], sizes[i]);
+        bmuClipSize[i] = sizes[i];
+        bmuClipCount = i + 1;
+    }
+    _glfw_free(_glfw.wl.clipboardString);
+    _glfw.wl.clipboardString = NULL;
+    _glfw.wl.selectionSource = wl_data_device_manager_create_data_source(_glfw.wl.dataDeviceManager);
+    if (!_glfw.wl.selectionSource)
+        return 0;
+    wl_data_source_add_listener(_glfw.wl.selectionSource, &dataSourceListener, NULL);
+    for (int i = 0; i < bmuClipCount; i++)
+        wl_data_source_offer(_glfw.wl.selectionSource, bmuClipMime[i]);
+    wl_data_device_set_selection(_glfw.wl.dataDevice, _glfw.wl.selectionSource, _glfw.wl.serial);
+    return 1;
+}
