+            BmuClipWrite* w = _glfw_calloc(1, sizeof(BmuClipWrite));
+            unsigned char* copy = _glfw_calloc(1, bmuClipSize[i] ? bmuClipSize[i] : 1);
+            if (!w || !copy) { _glfw_free(w); _glfw_free(copy); close(fd); return; }
+            memcpy(copy, bmuClipData[i], bmuClipSize[i]);
+            *w = (BmuClipWrite) { fd, copy, bmuClipSize[i] };
+            pthread_t thread;
+            pthread_attr_t attr;
+            pthread_attr_init(&attr);
+            pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+            if (pthread_create(&thread, &attr, bmuClipWriter, w) != 0) bmuClipWriter(w);
+            pthread_attr_destroy(&attr);
+            return;
+        }
+        if (!_glfw.wl.clipboardString) { close(fd); return; }
+    }
