+// bmu patch: clipboard data in other formats (e.g. image/png), offered next to or instead of text.
+#define BMU_CLIP_MAX 4
+static char* bmuClipMime[BMU_CLIP_MAX];
+static unsigned char* bmuClipData[BMU_CLIP_MAX];
+static size_t bmuClipSize[BMU_CLIP_MAX];
+static int bmuClipCount;
+
+typedef struct { int fd; unsigned char* data; size_t size; } BmuClipWrite;
+
+// Large payloads are written on a short-lived thread with its own copy, so a slow reader never blocks the app.
+static void* bmuClipWriter(void* arg)
+{
+    BmuClipWrite* w = arg;
+    // A reader that closes early must not kill the app with SIGPIPE: block it for this thread (write -> EPIPE).
+    sigset_t pipe_set;
+    sigemptyset(&pipe_set);
+    sigaddset(&pipe_set, SIGPIPE);
+    pthread_sigmask(SIG_BLOCK, &pipe_set, NULL);
+    size_t done = 0;
+    while (done < w->size)
+    {
+        const ssize_t n = write(w->fd, w->data + done, w->size - done);
+        if (n == -1 && errno == EINTR) continue;
+        if (n <= 0) break;
+        done += (size_t) n;
+    }
+    close(w->fd);
+    _glfw_free(w->data);
+    _glfw_free(w);
+    return NULL;
+}
+
+static void bmuClipClear(void)
+{
+    for (int i = 0; i < bmuClipCount; i++)
+    {
+        _glfw_free(bmuClipMime[i]);
+        _glfw_free(bmuClipData[i]);
+    }
+    bmuClipCount = 0;
+}
