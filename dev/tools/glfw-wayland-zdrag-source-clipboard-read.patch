 #endif // _GLFW_WAYLAND
 
+
+
+// ------------------------------------------------------------------------------------------------ bmu patch
+// Drag source (bmuStartDrag), clipboard reads in any MIME type (bmuGetClipboardData), the copy/move intent of
+// a drop from another bmu app (bmuDropAction). The data device stays at version 1 (no action negotiation): the
+// intent travels as application/x-bmu-drag-action ("copy" / "move") next to the dragged data.
+
+static char* bmuDragMime[BMU_CLIP_MAX];
+static unsigned char* bmuDragData[BMU_CLIP_MAX];
+static size_t bmuDragSize[BMU_CLIP_MAX];
+static int bmuDragCount;
+
+static void bmuDragClear(void)
+{
+    for (int i = 0; i < bmuDragCount; i++)
+    {
+        _glfw_free(bmuDragMime[i]);
+        _glfw_free(bmuDragData[i]);
+    }
+    bmuDragCount = 0;
+}
+
+static int bmuDragFind(const char* mime)
+{
+    for (int i = 0; i < bmuDragCount; i++)
+        if (strcmp(mime, bmuDragMime[i]) == 0) return i;
+    return -1;
+}
+
+static void bmuDragHandleTarget(void* userData, struct wl_data_source* source, const char* mimeType) {}
+
+static void bmuDragHandleSend(void* userData, struct wl_data_source* source, const char* mimeType, int fd)
+{
+    const int i = bmuDragFind(mimeType);
+    if (source != bmuDragSource || i < 0) { close(fd); return; }
+    BmuClipWrite* w = _glfw_calloc(1, sizeof(BmuClipWrite));
+    unsigned char* copy = _glfw_calloc(1, bmuDragSize[i] ? bmuDragSize[i] : 1);
+    if (!w || !copy) { _glfw_free(w); _glfw_free(copy); close(fd); return; }
+    memcpy(copy, bmuDragData[i], bmuDragSize[i]);
+    *w = (BmuClipWrite) { fd, copy, bmuDragSize[i] };
+    pthread_t thread;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    if (pthread_create(&thread, &attr, bmuClipWriter, w) != 0) bmuClipWriter(w);
+    pthread_attr_destroy(&attr);
+    // The target read the file list: the drop happened. A data device v1 target (older GLFW/SDL apps) never says
+    // it is done, and Hyprland then keeps the drag active (no pointer focus, no clicks for any window) until the
+    // source goes away: end the drag ourselves. The writer thread has its own copy of the data.
+    if (strcmp(mimeType, "text/uri-list") == 0)
+    {
+        bmuDragSource = NULL;
+        wl_data_source_destroy(source);
+    }
+}
+
+// The drag ended: dropped and finished (v3), or given up / refused (cancelled).
+static void bmuDragHandleCancelled(void* userData, struct wl_data_source* source)
+{
+    if (source == bmuDragSource) bmuDragSource = NULL;
+    wl_data_source_destroy(source);
+}
+
+static const struct wl_data_source_listener bmuDragSourceListener =
+{
+    bmuDragHandleTarget,
+    bmuDragHandleSend,
+    bmuDragHandleCancelled,
+    bmuSourceDropPerformed,
+    bmuDragHandleCancelled,   // dnd_finished
+    bmuSourceAction,
+};
+
+// Start a drag of `count` formats (copied) from the window under the pointer, while a mouse button is held.
+// The compositor owns the pointer until the drop, so the held buttons are reported as released now.
+// Returns 1 when the drag started.
+int bmuStartDrag(int count, const char* const* mimes, const void* const* datas, const size_t* sizes)
+{
+    _GLFWwindow* window = _glfw.wl.pointerFocus;
+    if (!window || count <= 0 || count > BMU_CLIP_MAX || !_glfw.wl.dataDeviceManager || !_glfw.wl.dataDevice)
+        return 0;
+    if (bmuDragSource)
+    {
+        wl_data_source_destroy(bmuDragSource);
+        bmuDragSource = NULL;
+    }
+    bmuDragClear();
+    for (int i = 0; i < count; i++)
+    {
+        bmuDragMime[i] = _glfw_strdup(mimes[i]);
+        bmuDragData[i] = _glfw_calloc(1, sizes[i] + 1);
+        bmuDragCount = i + 1;
+        if (!bmuDragMime[i] || !bmuDragData[i]) { bmuDragClear(); return 0; }
+        memcpy(bmuDragData[i], datas[i], sizes[i]);
+        bmuDragSize[i] = sizes[i];
+    }
+    bmuDragSource = wl_data_device_manager_create_data_source(_glfw.wl.dataDeviceManager);
+    if (!bmuDragSource) return 0;
+    wl_data_source_add_listener(bmuDragSource, &bmuDragSourceListener, NULL);
+    for (int i = 0; i < bmuDragCount; i++)
+        wl_data_source_offer(bmuDragSource, bmuDragMime[i]);
+    if (wl_proxy_get_version((struct wl_proxy*) bmuDragSource) >= 3)
+        wl_data_source_set_actions(bmuDragSource,
+                                   WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY | WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE);
+    wl_data_device_start_drag(_glfw.wl.dataDevice, bmuDragSource, window->wl.surface, NULL, bmuButtonSerial);
+    for (int b = 0; b <= GLFW_MOUSE_BUTTON_LAST; b++)
+        if (window->mouseButtons[b] == GLFW_PRESS)
+            _glfwInputMouseClick(window, b, GLFW_RELEASE, 0);
+    flushDisplay();
+    return 1;
+}
+
+// 1 while a drag started by bmuStartDrag is in progress.
+int bmuDragActive(void)
+{
+    return bmuDragSource != NULL;
+}
+
+// The copy/move intent of the last drop: "copy", "move", or "" (from an app that doesn't say).
+const char* bmuDropAction(void)
+{
+    return bmuDropActionText;
+}
+
+// Our drag dropped on one of our windows: deliver our own uri-list as a drop.
+static void bmuDropOwn(_GLFWwindow* window)
+{
+    const int a = bmuDragFind("application/x-bmu-drag-action");
+    snprintf(bmuDropActionText, sizeof(bmuDropActionText), "%s", a >= 0 ? (const char*) bmuDragData[a] : "");
+    const int u = bmuDragFind("text/uri-list");
+    if (u < 0 || !window) return;
+    char* string = _glfw_strdup((const char*) bmuDragData[u]);   // _glfwParseUriList modifies its input
+    if (!string) return;
+    int count;
+    char** paths = _glfwParseUriList(string, &count);
+    if (paths)
+        _glfwInputDrop(window, count, (const char**) paths);
+    for (int i = 0; i < count; i++)
+        _glfw_free(paths[i]);
+    _glfw_free(paths);
+    _glfw_free(string);
+}
+
+// The clipboard's data in `mime` (malloc'ed, zero-terminated, `*size` bytes; free with bmuFree), or NULL.
+// Reading another app's clipboard waits until it has sent everything (NULL after 0.5 s without data).
+void* bmuGetClipboardData(const char* mime, size_t* size)
+{
+    *size = 0;
+    if (_glfw.wl.selectionSource)
+    {
+        // our own clipboard: answer from memory (reading the offer would wait on ourselves)
+        for (int i = 0; i < bmuClipCount; i++)
+        {
+            if (strcmp(mime, bmuClipMime[i]) != 0) continue;
+            unsigned char* copy = _glfw_calloc(1, bmuClipSize[i] + 1);
+            if (!copy) return NULL;
+            memcpy(copy, bmuClipData[i], bmuClipSize[i]);
+            *size = bmuClipSize[i];
+            return copy;
+        }
+        if (_glfw.wl.clipboardString && strcmp(mime, "text/plain;charset=utf-8") == 0)
+        {
+            *size = strlen(_glfw.wl.clipboardString);
+            return _glfw_strdup(_glfw.wl.clipboardString);
+        }
+        return NULL;
+    }
+    if (!_glfw.wl.selectionOffer)
+        return NULL;
+    // never ask for a format the owner doesn't offer (some owners would leave the request unanswered)
+    if ((strcmp(mime, "text/plain;charset=utf-8") == 0 && !bmuSelectionText) ||
+        (strcmp(mime, "text/uri-list") == 0 && !bmuSelectionUris) ||
+        (strcmp(mime, "x-special/gnome-copied-files") == 0 && !bmuSelectionGnome))
+        return NULL;
+    char* data = readDataOfferAsString(_glfw.wl.selectionOffer, mime);
+    if (data)
+        *size = strlen(data);
+    return data;
+}
+
+// 1 while the clipboard still holds this app's last bmuSetClipboardData (not replaced by another client or by
+// glfwSetClipboardString): answers "did anyone copy something since?" without asking anyone.
+int bmuClipboardOwned(void)
+{
+    return _glfw.wl.selectionSource != NULL && bmuClipCount > 0;
+}
+
+void bmuFree(void* p)
+{
+    _glfw_free(p);
+}
